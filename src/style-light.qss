/* style-light.qss */
QMainWindow, QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #bdbdbd;
    padding: 8px 16px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:pressed {
    background-color: #2196f3;
}

QSlider::groove:horizontal {
    border: 1px solid #bdbdbd;
    height: 8px;
    background: #e0e0e0;
    margin: 2px 0;
}

QSlider::handle:horizontal {
    background: #2196f3;
    border: 1px solid #2196f3;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QTableView {
    background-color: #ffffff;
    alternate-background-color: #f0f0f0;
    gridline-color: #e0e0e0;
}

QHeaderView::section {
    background-color: #e0e0e0;
    color: #1a1a1a;
    padding: 4px;
    border: 1px solid #bdbdbd;
}

QLabel {
    font-size: 14px;
}

QProgressDialog {
    background-color: #f5f5f5;
    color: #1a1a1a;
}

QLineEdit {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus {
    border-color: #2196f3;
}
